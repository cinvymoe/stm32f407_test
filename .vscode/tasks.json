{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cargo build --target thumbv7em-none-eabihf",
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "cargo build --target thumbv7em-none-eabihf --release",
            "problemMatcher": [
                "$rustc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Flash (DAPLink)",
            "type": "shell",
            "command": "openocd -f openocd.cfg -c \"program target/thumbv7em-none-eabihf/debug/stm32f407_test verify reset exit\"",
            "problemMatcher": [],
            "dependsOn": [
                "Build (Debug)"
            ]
        },
        {
            "label": "Defmt(RTT via OpenOCD)",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "echo \"##defmt-begins##\" ; echo \"等待 RTT 服务器 (localhost:8765) 启动...\" ; echo \"##defmt-ready##\" ; while ! nc -z localhost 8765; do sleep 1; done ; echo \"RTT 服务器已启动，开始解码 defmt 日志\" ; exec nc localhost 8765 | defmt-print -e ${workspaceFolder}/target/thumbv7em-none-eabihf/debug/stm32f407_test"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "defmt",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.*)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "##defmt-begins##",
                    "endsPattern": "##defmt-ready##"
                }
            },
            "dependsOn": [
                "Build (Debug)"
            ]
        }
    ]
}