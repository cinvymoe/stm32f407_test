{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build (Debug)",
            "type": "shell",
            "command": "cargo build --target thumbv7em-none-eabihf --verbose",
            "problemMatcher": ["$rustc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Build (Release)",
            "type": "shell",
            "command": "cargo build --target thumbv7em-none-eabihf --release",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Flash (DAPLink)",
            "type": "shell",
            "command": "openocd -f openocd.cfg -c \"program target/thumbv7em-none-eabihf/debug/stm32f407_test verify reset exit\"",
            "problemMatcher": [],
            "dependsOn": ["Build (Debug)"]
        }
    ]
}