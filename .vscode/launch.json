{
    "version": "0.2.0",
    "configurations": [
        // 远程运行 openocd -f interface/cmsis-dap.cfg  -f target/stm32f4x.cfg -c "transport select swd"  -c "bindto 0.0.0.0"
        {
            "name": "Remote Debug (DAPLink)",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "external",
            "cwd": "${workspaceRoot}",
            "executable": "${workspaceRoot}/target/thumbv7em-none-eabihf/debug/stm32f407_test",
            "preLaunchTask": "Build (Debug)",
            "device": "STM32F407VG",
            "configFiles": [
                "openocd.cfg"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 1000,
                "decoders": [
                    {
                        "label": "1",
                        "port": 0,
                        "type": "binary"
                    }
                ]
            },
            // "serverpath": "openocd",  // OpenOCD路径（Windows下为openocd.exe）
            "svdFile": "${workspaceFolder}/.vscode/stm32f407.svd",
            "runToEntryPoint": "main",
            "gdbPath": "gdb-multiarch",
            "showDevDebugOutput": "raw",
            "gdbTarget": "192.168.1.111:3333",
            "interface": "swd",
        },
        {
            "preLaunchTask": "Build (Debug)",
            "type": "probe-rs-debug",
            "request": "launch",
            "name": "probe-rs",
            "cwd": "${workspaceFolder}",
            "chip": "STM32F407VG",
            "connectUnderReset": false,
            "speed": 4000,
            "runtimeExecutable": "probe-rs",
            "runtimeArgs": [
                "dap-server"
            ],
            "flashingConfig": {
                "flashingEnabled": true,
                "haltAfterReset": false
            },
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/target/thumbv7em-none-eabihf/debug/stm32f407_test",
                    "rttEnabled": true,
                    // Uncomment this if you've downloaded the SVD from
                    // https://github.com/raspberrypi/pico-sdk/raw/1.3.1/src/rp2040/hardware_regs/rp2040.svd
                    // and placed it in the .vscode directory
                    "svdFile": "${workspaceFolder}/STM32F407.svd",
                }
            ],
            "consoleLogLevel": "Info", //Error, Warn, Info, Debug, Trace
            "wireProtocol": "Swd"
        },
        {
            "name": "Debug (OpenOCD + ST-Link, F4 + RTT)",
            "type": "cortex-debug",
            "request": "launch",
            "preLaunchTask": "Build (Debug)",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceRoot}/target/thumbv7em-none-eabihf/debug/stm32f407_test",
            "device": "STM32F407VG",
            "svdFile": "${workspaceFolder}/.vscode/stm32f407.svd",
            "configFiles": [
                "openocd.cfg"
            ],
            "showDevDebugOutput": "raw",
            "postLaunchCommands": [
                // 启动 OpenOCD RTT 服务器，通道 0 在 8765 端口
                "monitor rtt server start 8765 0"
            ],
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "polling_interval": 20,
                "rtt_start_retry": 1000,
                "decoders": [
                    {
                        "label": "1",
                        "port": 0,
                        "type": "console",
                    }
                ]
            },
        },
    ]
}